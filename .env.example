# ==============================================
# BACKEND ENVIRONMENT VARIABLES
# ==============================================

# MySQL Database Configuration
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=XXX
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=YYY

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=XXX

# Authentication & Security
JWT_SECRET=XXX

# Server Configuration
PORT=8080
LOG_LEVEL=debug

# Cache Configuration
CACHE_EXPIRE_HOURS=2
FORCE_CACHE=false

# ==============================================
# FRONTEND/API CONFIGURATION (if not already present)
# ==============================================

# These two look almost identical and are NOT interchangeable — mixing them
# up has caused real prod bugs (see OnWave#20).
#
# API_BASE_URL: server-side only. Read at request time by the Next.js API
# proxy routes (src/app/api/**/route.ts) to reach the backend container over
# the docker-internal network. Never actually needs setting explicitly in
# docker-compose — the code's fallback default (http://backend:8080) already
# matches the compose service name, so this only matters if that ever
# changes. NOT read by anything that ends up in the browser bundle.
#
# NEXT_PUBLIC_API_BASE_URL: baked into the client-side bundle at BUILD time
# (via a docker build-arg in deploy-prod.sh) and used directly by the few
# pages that call the backend from the browser instead of through the proxy
# routes (src/hooks/use-subscriptions.ts, profile pages). MUST be a
# browser-reachable public URL (e.g. https://onwave.andruquinn.com/api) —
# a docker-internal hostname like http://backend:8080 will not work here,
# the browser can't resolve it.
API_BASE_URL=http://backend:8080
NEXT_PUBLIC_API_BASE_URL=https://your-public-domain.example/api

# Same client-vs-server distinction applies to the WebSocket URL — this one
# is always browser-facing (used directly by NotificationContext), so it
# must be a public wss:// URL, never a docker-internal address.
NEXT_PUBLIC_WS_URL=wss://your-public-domain.example/ws

# Port the `notifications` RUN_MODE service listens on — must match the
# port nginx.prod.conf's /ws location proxies to.
NOTIFICATIONS_PORT=8081

# Environment
NODE_ENV=development